{
  "name": "@notaunty/opencode-agent",
  "version": "2.0.2",
  "description": "OpenCode V2 Agent Sessions with Vercel Chat SDK transports and durable wake timers",
  "repository": {
    "type": "git",
    "url": "https://github.com/notAunty/opencode-agent"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js",
    "./rpc": "./dist/src/rpc.js"
  },
  "files": [
    "dist/src",
    "scripts",
    "examples",
    "README.md",
    "docs.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "npm run check && npm run build && npm test",
    "prepack": "npm run check && npm run build",
    "dist": "npm pack",
    "prepublishOnly": "npm run verify",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.22 <3"
  },
  "dependencies": {
    "@chat-adapter/discord": "4.41.1",
    "@chat-adapter/slack": "4.41.1",
    "@chat-adapter/state-redis": "4.41.1",
    "@chat-adapter/telegram": "4.41.1",
    "@opencode/client": "2.0.22",
    "@opencode/plugin": "2.0.22",
    "@opencode/schema": "2.0.22",
    "@slack/socket-mode": "3.1.0",
    "@slack/web-api": "8.2.0",
    "abort-controller": "3.0.0",
    "chat": "4.41.1",
    "dotenv": "18.0.5",
    "telegraf": "4.16.3",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode/sdk": "2.0.22",
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
